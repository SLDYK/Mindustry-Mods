{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "RA2: 构建并安装 (ra2-controls)",
            "type": "shell",
            "command": "bash",
            "args": ["${workspaceFolder}/tools/pack.sh", "--install"],
            "problemMatcher": [],
            "presentation": { "reveal": "always" },
            "windows": {
                "command": "powershell",
                "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/pack.ps1", "-Install"]
            }
        },
        {
            "label": "RA2: 构建 (ra2-controls)",
            "type": "shell",
            "command": "bash",
            "args": ["${workspaceFolder}/tools/pack.sh"],
            "problemMatcher": [],
            "presentation": { "reveal": "always" },
            "windows": {
                "command": "powershell",
                "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/pack.ps1"]
            }
        },
        // ---- Erekir Items（Windows：pack.ps1 + 离线校验脚本）----
        {
            "label": "Erekir Items: 构建 / 安装",
            "type": "shell",
            "command": "powershell",
            "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/pack.ps1", "-Mod", "erekir-items", "-Install"],
            "problemMatcher": ["$javac"],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            "label": "Erekir Items: 校验产物",
            "type": "shell",
            "command": "powershell",
            "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/eiverify/verify.ps1"],
            "problemMatcher": ["$javac"],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            "label": "Erekir Items: 重新生成贴图",
            "type": "shell",
            "command": "powershell",
            "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/gen-sprites.ps1"],
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        // ---- Enemy Pause（macOS：依赖 build.sh 等脚本与 tools/jdk 内置工具链）----
        {
            "label": "Enemy Pause: 构建 / 安装 / 拷桌面",
            "type": "shell",
            "command": "\"${workspaceFolder}/build.sh\" && \"${workspaceFolder}/deploy.sh\"",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$javac"],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
            "windows": {
                "command": "powershell",
                "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/pack.ps1", "-Mod", "Enemy Pause", "-Install", "-Desktop"],
                "problemMatcher": ["$javac"]
            }
        },
        {
            "label": "Mindustry: 构建模组",
            "type": "shell",
            "command": "\"${workspaceFolder}/build.sh\"",
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$javac"],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            "label": "Mindustry: 构建并部署",
            "type": "shell",
            "command": "\"${workspaceFolder}/build.sh\" && \"${workspaceFolder}/deploy.sh\"",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$javac"],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            "label": "Mindustry: 校验产物",
            "type": "shell",
            "command": "\"${workspaceFolder}/check.sh\"",
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        }
    ]
}
