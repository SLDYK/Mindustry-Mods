# 游戏内显示的模组名
displayName: "Enemy Pause"

# 模组内部名（唯一标识；贴图引用也要用它作前缀）
name: "enemy-pause"

# 作者
author: "SLDYK"

# 主类的全限定名
main: "enemypause.EnemyPauseMod"

# 模组说明
description: "战役模式下，按快捷键暂停 / 继续敌方侧的倒计时：下一波进攻，以及地图目标里的计时目标（如「敌人来袭」）。不影响敌方单位的行动与工厂生产。"

# 模组版本
version: "0.4.0"

# 能运行本模组的最低游戏版本
# 在 160.1 上实测运行；159.7 上验证过编译与反射字段均兼容，所以不把门槛抬到 160
minGameVersion: "159"

# 标记为 Java 模组
java: true
