# 游戏内显示的模组名
# 模组是个容器，以后会陆续加别的建筑，所以这里用中性的名字，
# 具体建筑名走 bundles 里的 block.<内容名>.name
displayName: "埃里克尔物品"

# 模组内部名（唯一标识）：既是内容名前缀，也是贴图文件名的前缀
# 例：可调电力节点的完整内容名 = erekir-items-tunable-node
name: "erekir-items"

author: "SLDYK"

main: "erekiritems.ErekirItemsMod"

description: "埃里克尔内容模组。目前含两个建筑：可调电力节点（点开即可设置输出功率，0 ~ 1000000 电力/秒）；资源源（凭空产出物品、液体和热量，三者都可单独设置，物品与液体的类型随意挑）。开局即可建造、无需研究。"

# 模组版本
version: "1.2.0"

# 编译与实机验证所用的游戏版本：v8 / build 160.4（Version.build = 160）
minGameVersion: "160"

# 标记为 Java 模组
java: true
