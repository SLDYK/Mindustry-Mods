# 游戏内显示的模组名
displayName: "埃里克尔可调电力节点"

# 模组内部名（唯一标识）：既是内容名前缀，也是贴图文件名的前缀
# 本模组方块的完整内容名 = erekir-power-node-tunable-node
name: "erekir-power-node"

author: "SLDYK"

main: "erekirpower.ErekirPowerMod"

description: "给行星埃里克尔加一个可调电力节点：点开方块即可设置输出功率（0 ~ 1000000 电力/秒），接上光束节点就能供电。开局即可建造，无需研究。"

version: "1.0.0"

# 编译与实机验证所用的游戏版本：v8 / build 160.4（Version.build = 160）
minGameVersion: "160"

# 标记为 Java 模组
java: true
